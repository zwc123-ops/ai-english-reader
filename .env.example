# Server port (defaults to 3000 in web mode, 18789 in Electron)
PORT=3000

# Optional server-side DeepSeek API key fallback
DEEPSEEK_API_KEY=

# Optional access token required when exposing server-side DEEPSEEK_API_KEY publicly
API_ACCESS_TOKEN=

# Optional outbound HTTP proxy (leave empty unless needed)
HTTPS_PROXY=
